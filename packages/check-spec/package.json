{
  "name": "@ipab/check-spec",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Check definition views and bounded Markdown resource loading.",
  "license": "MIT",
  "engines": {
    "node": ">=22.15.0"
  },
  "imports": {
    "#check-shape": {
      "types": "./src/shape-validator.d.ts",
      "default": "./dist/shape-validator.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bundle": {
      "types": "./dist/bundle.d.ts",
      "import": "./dist/bundle.js"
    },
    "./style.css": "./src/style.css"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run --root . --config ../../vitest.config.ts",
    "test-ci": "vitest run --root . --config ../../vitest.config.ts --tags-filter \"!release-e2e\"",
    "test-coverage": "vitest run --root . --config ../../vitest.config.ts --coverage"
  },
  "dependencies": {
    "ajv": "catalog:",
    "react-markdown": "catalog:",
    "remark-gfm": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.3.1"
  },
  "devDependencies": {
    "esbuild": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/node": "catalog:",
    "jsdom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
