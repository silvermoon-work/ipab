{
  "name": "@silvermoon-work/ipab",
  "version": "0.0.0",
  "private": true,
  "description": "Node subprocess CLI workspace for InterPlanetary Artifact Bundle.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silvermoon-work/ipab.git"
  },
  "homepage": "https://github.com/silvermoon-work/ipab#readme",
  "bugs": {
    "url": "https://github.com/silvermoon-work/ipab/issues"
  },
  "engines": {
    "node": "^22.15.0 || >=23.5.0"
  },
  "packageManager": "pnpm@11.28.12",
  "scripts": {
    "build": "turbo run build",
    "check": "run-s format-check build typecheck lint test-coverage lint-package",
    "check-ci": "run-s format-check build typecheck lint test-ci lint-package",
    "check-release": "run-s check test-package-smoke",
    "clean": "rimraf --glob \"{dist,coverage,.turbo}\" \"{apps,packages}/*/{dist,coverage,.turbo}\"",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint-package": "turbo run lint-package",
    "link-cli": "node scripts/link-cli.mjs",
    "test": "turbo run test --concurrency=1",
    "test-ci": "turbo run test-ci --concurrency=1",
    "test-package-smoke": "package-smoke --verify scripts/package-smoke.mjs --allow-build esbuild",
    "test-coverage": "turbo run test-coverage --concurrency=1",
    "typecheck": "tsc --noEmit --project tsconfig.json && turbo run typecheck"
  },
  "devDependencies": {
    "@silvermoon-work/devtool.package-smoke": "workspace:*",
    "@silvermoon-work/devtool.publish-gate": "0.2.0",
    "@ipab/bundle-viewer": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "@ipab/web-app": "workspace:*",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "npm-run-all2": "8.0.4",
    "publint": "catalog:",
    "rimraf": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "vite": "catalog:",
    "yaml": "catalog:"
  }
}
