{
  "name": "@ipab/bundle-builder",
  "version": "0.1.0-rc.2",
  "private": false,
  "description": "Deterministic bounded UnixFS Bundle CAR construction from repeatable file trees.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silvermoon-work/ipab.git",
    "directory": "packages/bundle-builder"
  },
  "homepage": "https://github.com/silvermoon-work/ipab#readme",
  "bugs": {
    "url": "https://github.com/silvermoon-work/ipab/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepublishOnly": "publish-gate check --workflow ci.yaml --workflow release-validation.yaml",
    "build": "tsc --project tsconfig.build.json",
    "lint-package": "publint --strict",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run --root . --config ../../vitest.config.ts",
    "test-ci": "vitest run --root . --config ../../vitest.config.ts --tags-filter \"(unit or mock) and !release-e2e\"",
    "test-coverage": "vitest run --root . --config ../../vitest.config.ts --coverage"
  },
  "dependencies": {
    "ipfs-unixfs": "catalog:",
    "@ipab/bundle": "workspace:*",
    "@ipld/car": "catalog:",
    "@ipld/dag-pb": "catalog:",
    "ipfs-unixfs-importer": "catalog:",
    "multiformats": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
