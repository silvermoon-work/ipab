{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".node-version", "tsconfig.json", "vitest.config.ts"],
  "tasks": {
    "@ipab/bundle#test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/pointer-worker/src/**",
        "$TURBO_ROOT$/packages/pointer-worker/test/**"
      ]
    },
    "@ipab/bundle#test-ci": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/pointer-worker/src/**",
        "$TURBO_ROOT$/packages/pointer-worker/test/**"
      ]
    },
    "@ipab/bundle#test-coverage": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/pointer-worker/src/**",
        "$TURBO_ROOT$/packages/pointer-worker/test/**"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["VITEST_MAX_WORKERS"],
      "outputs": []
    },
    "test-ci": {
      "dependsOn": ["build"],
      "env": ["VITEST_MAX_WORKERS"],
      "outputs": []
    },
    "test-coverage": {
      "dependsOn": ["^build"],
      "env": ["VITEST_MAX_WORKERS"],
      "outputs": ["coverage/**"]
    },
    "lint-package": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "native-test": {
      "dependsOn": ["build"],
      "cache": false
    },
    "smoke": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
