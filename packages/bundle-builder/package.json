{
  "name": "@ipab/bundle-builder",
  "version": "0.0.0",
  "private": true,
  "description": "Deterministic bounded UnixFS Bundle CAR construction from repeatable file trees.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.15.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node scripts/test.mjs",
    "test-coverage": "node scripts/test-coverage.mjs"
  },
  "dependencies": {
    "@ipab/bundle": "workspace:*",
    "@ipld/car": "catalog:",
    "@ipld/dag-pb": "catalog:",
    "ipfs-unixfs-importer": "catalog:",
    "multiformats": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
