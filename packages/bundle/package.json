{
  "name": "@ipab/bundle",
  "version": "0.1.0-rc.1",
  "private": false,
  "description": "Validated UnixFS Content Bundles and single-block DAG-CBOR schemas.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "homepage": "https://github.com/silvermoon-work/ipab#readme",
  "bugs": {
    "url": "https://github.com/silvermoon-work/ipab/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./pointer/protocol": {
      "types": "./dist/pointer/protocol.d.ts",
      "import": "./dist/pointer/protocol.js"
    },
    "./pointer/crypto": {
      "types": "./dist/pointer/crypto.d.ts",
      "import": "./dist/pointer/crypto.js"
    },
    "./pointer/certificates": {
      "types": "./dist/pointer/certificates.d.ts",
      "import": "./dist/pointer/certificates.js"
    },
    "./pointer/client": {
      "types": "./dist/pointer/client.d.ts",
      "import": "./dist/pointer/client.js"
    },
    "./pointer/protected-files": {
      "types": "./dist/pointer/protected-files.d.ts",
      "import": "./dist/pointer/protected-files.js"
    },
    "./pointer/node-runtime": {
      "types": "./dist/pointer/node-runtime.d.ts",
      "import": "./dist/pointer/node-runtime.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./data": {
      "types": "./dist/data.d.ts",
      "import": "./dist/data.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silvermoon-work/ipab.git",
    "directory": "packages/bundle"
  },
  "scripts": {
    "prepublishOnly": "publish-gate check --workflow ci.yaml --workflow release-validation.yaml",
    "build": "tsc --project tsconfig.build.json",
    "lint-package": "publint --strict",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run --root . --config ../../vitest.config.ts",
    "test-ci": "vitest run --root . --config ../../vitest.config.ts --tags-filter \"(unit or mock) and !release-e2e\"",
    "test-coverage": "vitest run --root . --config ../../vitest.config.ts --coverage"
  },
  "dependencies": {
    "ajv": "catalog:",
    "@ipld/dag-cbor": "catalog:",
    "@ipab/ipfs-store": "workspace:*",
    "multiformats": "catalog:",
    "typebox": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@ipld/dag-pb": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "ipfs-unixfs-importer": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
