{
  "name": "@ipab/bundle-builder",
  "version": "0.1.0-rc.0",
  "private": false,
  "description": "Deterministic bounded UnixFS Bundle CAR construction from repeatable file trees.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silvermoon-work/ipab.git",
    "directory": "packages/bundle-builder"
  },
  "homepage": "https://github.com/silvermoon-work/ipab#readme",
  "bugs": {
    "url": "https://github.com/silvermoon-work/ipab/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint-package": "node scripts/lint-package.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node scripts/test.mjs",
    "test-ci": "node scripts/test-ci.mjs",
    "test-coverage": "node scripts/test-coverage.mjs"
  },
  "dependencies": {
    "@ipab/bundle": "workspace:*",
    "@ipld/car": "catalog:",
    "@ipld/dag-pb": "catalog:",
    "ipfs-unixfs-importer": "catalog:",
    "multiformats": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
