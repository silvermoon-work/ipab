{
  "name": "IPAB Message",
  "description": "A message displayed by the example viewer.",
  "entry": {
    "path": "message.json",
    "contentType": "application/json",
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message"],
      "properties": { "message": { "type": "string" } }
    },
    "defaultValue": { "message": "Hello from a Content Bundle." }
  }
}
