{
  "name": "@ipab/bundle",
  "version": "0.1.0-rc.0",
  "private": false,
  "description": "Validated UnixFS Content Bundles and single-block DAG-CBOR schemas.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "homepage": "https://github.com/silvermoon-work/ipab#readme",
  "bugs": {
    "url": "https://github.com/silvermoon-work/ipab/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./data": {
      "types": "./dist/data.d.ts",
      "import": "./dist/data.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silvermoon-work/ipab.git",
    "directory": "packages/bundle"
  },
  "scripts": {
    "prepublishOnly": "publish-gate check --workflow ci.yaml --workflow release-validation.yaml",
    "build": "node scripts/build.mjs",
    "lint-package": "node scripts/lint-package.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node scripts/test.mjs",
    "test-ci": "node scripts/test-ci.mjs",
    "test-coverage": "node scripts/test-coverage.mjs"
  },
  "dependencies": {
    "@ipld/dag-cbor": "catalog:",
    "@ipab/ipfs-store": "workspace:*",
    "multiformats": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@ipld/dag-pb": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "ipfs-unixfs-importer": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
