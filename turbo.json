{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".node-version", "tsconfig.json", "vitest.config.ts"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test-coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "lint-package": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "native-test": {
      "dependsOn": ["build"],
      "cache": false
    },
    "smoke": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
