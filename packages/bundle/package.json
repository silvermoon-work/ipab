{
  "name": "@ipab/bundle",
  "version": "0.1.0-rc.0",
  "private": true,
  "description": "Validated UnixFS Content Bundles and single-block DAG-CBOR schemas.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "engines": {
    "node": ">=22.15.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silvermoon-work/ipab.git",
    "directory": "packages/bundle"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node scripts/test.mjs",
    "test-coverage": "node scripts/test-coverage.mjs"
  },
  "dependencies": {
    "@ipld/dag-cbor": "catalog:",
    "@ipab/ipfs-store": "workspace:*",
    "multiformats": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@ipld/dag-pb": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "ipfs-unixfs-importer": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
