{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    ".node-version",
    "tsconfig.json",
    "vitest.config.ts",
    "scripts/lib/**"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["VITEST_MAX_WORKERS"],
      "outputs": []
    },
    "test-ci": {
      "dependsOn": ["build"],
      "env": ["VITEST_MAX_WORKERS"],
      "outputs": []
    },
    "test-coverage": {
      "dependsOn": ["^build"],
      "env": ["VITEST_MAX_WORKERS"],
      "outputs": ["coverage/**"]
    },
    "lint-package": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "native-test": {
      "dependsOn": ["build"],
      "cache": false
    },
    "smoke": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
