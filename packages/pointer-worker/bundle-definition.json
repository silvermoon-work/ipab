{
  "contentType": "application/json",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["version", "files", "config"],
    "properties": {
      "version": { "const": 1 },
      "files": {
        "type": "array",
        "minItems": 1,
        "maxItems": 256,
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1 }
      },
      "config": {
        "type": "object",
        "additionalProperties": false,
        "required": ["main", "compatibility_date"],
        "properties": {
          "main": { "const": "worker.mjs" },
          "compatibility_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "compatibility_flags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "durable_objects": {
            "type": "object",
            "additionalProperties": false,
            "required": ["bindings"],
            "properties": {
              "bindings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "class_name"],
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "class_name": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          },
          "migrations": { "type": "array", "items": { "type": "object" } },
          "observability": { "type": "object" }
        }
      }
    }
  }
}
