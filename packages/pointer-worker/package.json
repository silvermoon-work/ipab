{
  "name": "@ipab/pointer-worker",
  "version": "0.0.0",
  "private": true,
  "description": "Signed publication pointers with owner-issued member certificates and atomic revision CAS.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run --root . --config ../../vitest.config.ts",
    "test-ci": "vitest run --root . --config ../../vitest.config.ts --tags-filter \"(unit or mock) and !release-e2e\"",
    "test-coverage": "vitest run --root . --config ../../vitest.config.ts --coverage",
    "cli": "tsx scripts/cli.ts"
  },
  "dependencies": {
    "multiformats": "catalog:"
  },
  "devDependencies": {
    "@ipab/bundle-builder": "workspace:*",
    "esbuild": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
