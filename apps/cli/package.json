{
  "name": "@ipab/cli",
  "version": "0.1.0-rc.0",
  "private": false,
  "description": "Node subprocess IPAB host.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silvermoon-work/ipab.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/silvermoon-work/ipab#readme",
  "bugs": {
    "url": "https://github.com/silvermoon-work/ipab/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "bin": {
    "ipab": "dist/main.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepublishOnly": "publish-gate check --workflow ci.yaml --workflow release-validation.yaml",
    "build": "node scripts/build.mjs",
    "lint-package": "node scripts/lint-package.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node scripts/test.mjs",
    "test-ci": "node scripts/test-ci.mjs",
    "test-coverage": "node scripts/test-coverage.mjs"
  },
  "dependencies": {
    "liquidjs": "catalog:",
    "@ipab/web-app": "workspace:*",
    "esbuild": "catalog:",
    "@ipab/bundle-builder": "workspace:*",
    "@ipld/car": "catalog:",
    "@ipld/dag-pb": "catalog:",
    "@ipab/bundle": "workspace:*",
    "@ipab/ipfs-store": "workspace:*",
    "ipfs-unixfs": "catalog:",
    "ipfs-unixfs-importer": "catalog:",
    "multiformats": "catalog:",
    "string-width": "catalog:",
    "ignore": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@ipab/bundle-viewer": "workspace:*",
    "vite": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:"
  }
}
