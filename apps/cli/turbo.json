{
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/templates/node/**",
        "$TURBO_ROOT$/templates/web-app/**"
      ]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/templates/bundle-viewer/**"]
    },
    "test-coverage": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/templates/bundle-viewer/**"]
    }
  }
}
